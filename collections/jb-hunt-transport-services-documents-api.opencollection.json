                {
                  "name": "shipmentId",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "documentType",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a document related to a J.B. Hunt shipment, such as a bill of lading or proof of delivery."
        }
      ]
